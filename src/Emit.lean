/-! A code generator. Lean prints the C for the plan, so the plan runs as plain C
with no Lean runtime in the loop (no allocation, no FFI result objects).

Run by `make`: `lean --run src/Emit.lean generated/plan_emit.c`.

What is and is not checked: `Model.lean` proves that "Last, then Previous, stop after n rows"
computes the last n rows. Nothing proves that the text printed here has that shape. The
differential test (`make test`) and the checksum in `make bench` are the evidence. -/

/-- C that reads the last `n` rows with the cursor: one `sqlite3BtreeLast`, then
`sqlite3BtreePrevious` until `n` rows are read. `rowAction` is C that runs once per row,
with `id`, `body` and `len` in scope and the running result in `acc`. -/
def emitLastN (fn rowAction : String) : String :=
  String.intercalate "\n" [
    "/* generated by src/Emit.lean - do not edit */",
    s!"static uint64_t {fn}(LDb *d, uint64_t n) \{",
    "  uint64_t acc = 0, k = n;",
    "  size_t len;",
    "  if (n == 0 || !ldb_last(d)) return 0;          /* sqlite3BtreeLast */",
    "  for (;;) {",
    "    int64_t id = ldb_rowid(d);",
    "    const char *body = ldb_body(d, &len);",
    "    (void)id; (void)body;",
    s!"    {rowAction}",
    "    if (--k == 0) break;                          /* never step past the n-th row */",
    "    if (!ldb_previous(d)) break;                  /* sqlite3BtreePrevious */",
    "  }",
    "  return acc;",
    "}",
    ""]

def main (args : List String) : IO UInt32 := do
  let [out] := args | IO.eprintln "usage: Emit <output .c file>"; return 2
  -- The benchmark's row action: the same checksum every other path computes.
  IO.FS.writeFile out (emitLastN "plan_last_n" "acc += (uint64_t)id + (uint64_t)len;")
  return 0
